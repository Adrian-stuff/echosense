{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "echosense-sim",
      "runtimeExecutable": ".venv/bin/echosense",
      "runtimeArgs": ["run", "--source", "sim", "--no-browser", "--port", "8080"],
      "port": 8080
    },
    {
      "name": "echosense-sim-silent",
      "runtimeExecutable": ".venv/bin/echosense",
      "runtimeArgs": ["run", "--source", "sim", "--no-browser", "--audio", "none", "--port", "8081",
                      "--settings", ".claude/test-settings.json"],
      "port": 8081
    }
  ]
}
